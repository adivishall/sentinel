{
  "policy_id": "dispute-refund",
  "version": 2,
  "workflow": "dispute",
  "effective_from": "2026-09-20",
  "description": "Refund control v2: risk threshold lowered 75 -> 70; medium AI-security findings now hold for review.",
  "required_fields": [
    "amount",
    "evidence_verdict",
    "security_severity",
    "risk_score",
    "policy_auto_limit",
    "prior_disputes_90d"
  ],
  "rules": [
    {
      "id": "block-critical-ai-security",
      "when": [
        {
          "field": "security_severity",
          "op": "==",
          "value": "CRITICAL"
        }
      ],
      "outcome": "BLOCK",
      "reason": "Critical AI-security finding on the untrusted input."
    },
    {
      "id": "block-capability-escalation",
      "when": [
        {
          "field": "capability_escalation",
          "op": "is_true"
        }
      ],
      "outcome": "BLOCK",
      "reason": "The model requested a capability outside its surface."
    },
    {
      "id": "block-unsupported-claim",
      "when": [
        {
          "field": "evidence_verdict",
          "op": "in",
          "value": [
            "UNSUPPORTED",
            "CONTRADICTED"
          ]
        }
      ],
      "outcome": "BLOCK",
      "reason": "Verified ledger evidence does not support the claim."
    },
    {
      "id": "review-insufficient-evidence",
      "when": [
        {
          "field": "evidence_verdict",
          "op": "==",
          "value": "INSUFFICIENT"
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "The claim cannot yet be verified against the ledger."
    },
    {
      "id": "review-over-auto-limit",
      "when": [
        {
          "field": "amount",
          "op": ">",
          "value": 50000
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Refund exceeds the ₹50,000 auto-approval limit."
    },
    {
      "id": "review-critical-risk",
      "when": [
        {
          "field": "risk_score",
          "op": ">=",
          "value": 70
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Dispute risk >= 70."
    },
    {
      "id": "review-high-ai-security",
      "when": [
        {
          "field": "security_severity",
          "op": "==",
          "value": "HIGH"
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "High-severity AI-security finding; a human confirms before money moves."
    },
    {
      "id": "review-repeat-disputer",
      "when": [
        {
          "field": "prior_disputes_90d",
          "op": ">=",
          "value": 3
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Three or more disputes in 90 days."
    },
    {
      "id": "review-medium-ai-security",
      "when": [
        {
          "field": "security_severity",
          "op": "==",
          "value": "MEDIUM"
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Medium-severity AI-security finding; hold for a human."
    }
  ]
}
