{
  "policy_id": "dispute-refund",
  "version": 4,
  "workflow": "dispute",
  "default_outcome": "ALLOW",
  "effective_from": "2026-09-29",
  "description": "Refund control v4: v3 plus fact provenance -- a failed or revoked signature blocks; unverified facts go to a human; a refund above 25,000 needs the ledger's signed statement.",
  "required_fields": [
    "amount",
    "evidence_verdict",
    "security_severity",
    "risk_score",
    "policy_auto_limit",
    "prior_disputes_90d",
    "refund_state",
    "transaction_status",
    "merchant_response",
    "auth_strength"
  ],
  "rules": [
    {
      "id": "block-failed-fact-provenance",
      "when": [
        {
          "field": "facts_provenance",
          "op": "in",
          "value": [
            "INVALID",
            "REVOKED"
          ]
        }
      ],
      "outcome": "BLOCK",
      "reason": "The record's signed statement failed verification or its key was revoked: a tamper signal, never a basis for action."
    },
    {
      "id": "review-unverified-facts",
      "when": [
        {
          "field": "facts_provenance",
          "op": "in",
          "value": [
            "UNTRUSTED",
            "EXPIRED",
            "SUPERSEDED",
            "NONE"
          ]
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Nothing establishes these facts (request-body, expired or superseded, or none recorded): a human must, before anything executes."
    },
    {
      "id": "review-high-value-unsigned-facts",
      "when": [
        {
          "field": "amount",
          "op": ">",
          "value": 25000
        },
        {
          "field": "facts_provenance",
          "op": "==",
          "value": "TRUSTED_LOCAL"
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "A refund above 25,000 needs the issuer's signed statement (VERIFIED_EXTERNAL); an unsigned stored record goes to a human."
    },
    {
      "id": "block-already-refunded",
      "when": [
        {
          "field": "refund_state",
          "op": "==",
          "value": "refunded"
        }
      ],
      "outcome": "BLOCK",
      "reason": "The ledger shows this transaction was already refunded; a second refund is a double payment."
    },
    {
      "id": "block-reversed-transaction",
      "when": [
        {
          "field": "transaction_status",
          "op": "==",
          "value": "reversed"
        }
      ],
      "outcome": "BLOCK",
      "reason": "The transaction was reversed; there is nothing to refund."
    },
    {
      "id": "block-critical-ai-security",
      "when": [
        {
          "field": "security_severity",
          "op": "==",
          "value": "CRITICAL"
        }
      ],
      "outcome": "BLOCK",
      "reason": "Critical AI-security finding on the untrusted input."
    },
    {
      "id": "block-capability-escalation",
      "when": [
        {
          "field": "capability_escalation",
          "op": "is_true"
        }
      ],
      "outcome": "BLOCK",
      "reason": "The model requested a capability outside its surface."
    },
    {
      "id": "block-unsupported-claim",
      "when": [
        {
          "field": "evidence_verdict",
          "op": "in",
          "value": [
            "UNSUPPORTED",
            "CONTRADICTED"
          ]
        }
      ],
      "outcome": "BLOCK",
      "reason": "Verified ledger evidence does not support the claim."
    },
    {
      "id": "review-insufficient-evidence",
      "when": [
        {
          "field": "evidence_verdict",
          "op": "==",
          "value": "INSUFFICIENT"
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "The claim cannot yet be verified against the ledger."
    },
    {
      "id": "review-over-auto-limit",
      "when": [
        {
          "field": "amount",
          "op": ">",
          "value": 50000
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Refund exceeds the ₹50,000 auto-approval limit."
    },
    {
      "id": "review-critical-risk",
      "when": [
        {
          "field": "risk_score",
          "op": ">=",
          "value": 70
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Dispute risk >= 70."
    },
    {
      "id": "review-high-ai-security",
      "when": [
        {
          "field": "security_severity",
          "op": "==",
          "value": "HIGH"
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "High-severity AI-security finding; a human confirms before money moves."
    },
    {
      "id": "review-repeat-disputer",
      "when": [
        {
          "field": "prior_disputes_90d",
          "op": ">=",
          "value": 3
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Three or more disputes in 90 days."
    },
    {
      "id": "review-medium-ai-security",
      "when": [
        {
          "field": "security_severity",
          "op": "==",
          "value": "MEDIUM"
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "Medium-severity AI-security finding; hold for a human."
    },
    {
      "id": "hold-refund-pending",
      "when": [
        {
          "field": "refund_state",
          "op": "==",
          "value": "pending"
        }
      ],
      "outcome": "TEMPORARY_HOLD",
      "reason": "A refund is already in flight; hold until it settles."
    },
    {
      "id": "review-merchant-contested",
      "when": [
        {
          "field": "merchant_response",
          "op": "==",
          "value": "contested"
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "The merchant contests the claim; a human weighs both sides."
    },
    {
      "id": "review-unauthorised-strong-auth",
      "when": [
        {
          "field": "claim_type",
          "op": "==",
          "value": "unauthorized"
        },
        {
          "field": "auth_strength",
          "op": "in",
          "value": [
            "otp",
            "biometric"
          ]
        }
      ],
      "outcome": "REQUIRE_HUMAN_REVIEW",
      "reason": "An 'unauthorised' claim on a transaction that passed a strong second factor needs a human."
    }
  ]
}
