# Live mode (real Claude agents + adjudicator). Without this, the repo runs
# fully in deterministic OFFLINE mode.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for agents/adjudicator.
SENTINEL_MODEL=claude-sonnet-4-5-20250929
# Force offline even if a key is present:
# SENTINEL_FORCE_OFFLINE=1
