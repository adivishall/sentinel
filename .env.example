# Live mode: real Claude agents + adjudicator instead of the offline simulator.
# Offline mode (make offline / make all) needs NONE of this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: pick a cheaper/faster model for the eval loop.
# Default is claude-opus-5. For a large loop, claude-haiku-4-5 or claude-sonnet-5
# are much cheaper and usually show the same behaviour.
# SENTINEL_MODEL=claude-haiku-4-5
