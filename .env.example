# Live mode: real Claude agents instead of the offline simulator.
# Offline mode (the default; make test / make eval / make api) needs NONE of this.
ANTHROPIC_API_KEY=sk-ant-...
# SENTINEL_FORCE_OFFLINE=0          # unset/0 to allow live mode when a key is present
# SENTINEL_MODEL=claude-haiku-4-5   # cheaper/faster model for the evaluation loop

# API
# SENTINEL_API_KEY=choose-a-strong-token   # if set, /v1/* requires Authorization: Bearer <token>
# SENTINEL_RATE_LIMIT=600                  # requests / minute / client (0 = off)
# SENTINEL_DB=data/sentinel.db             # SQLite store (:memory: for ephemeral)
# SENTINEL_LOG=INFO                        # structured JSON logs
# SENTINEL_AUDIT_KEY=choose-a-strong-key   # HMAC key for signed audit checkpoints (sentinel audit checkpoint / verify --checkpoint)
