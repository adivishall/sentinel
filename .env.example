# Every variable Sentinel reads (docs/DEPLOYMENT.md has the full table).
# Offline mode (the default; make test / make eval / make api) needs NONE of this.

# ---- live model (optional) -------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# SENTINEL_FORCE_OFFLINE=0                 # unset/0 to allow live mode when a key is present
# SENTINEL_MODEL=claude-opus-5-5           # live model id
# SENTINEL_EFFORT=low                      # live effort level

# ---- serving ---------------------------------------------------------------------------
# SENTINEL_API_KEY=...                     # bearer token, 16+ characters (required to serve a network address)
# SENTINEL_API_KEY_FILE=/run/secrets/api_key   # better: read the key from a mounted secret
# SENTINEL_INSECURE_DEMO=1                 # serve a network address WITHOUT a key (throwaway demos; audited)
# SENTINEL_ALLOWED_HOSTS=sentinel.example.com  # public names behind a TLS proxy
# SENTINEL_MAX_CONNECTIONS=64              # concurrent connections
# SENTINEL_RATE_LIMIT=600                  # requests / minute / client (0 = off)
# SENTINEL_LOG=INFO                        # structured JSON logs
# SENTINEL_UI_DIR=/app/ui                  # console files (default: the checkout, else ./ui)
# SENTINEL_RESULTS_DIR=/app/results        # evaluation results (default: the checkout, else ./results)

# ---- data ------------------------------------------------------------------------------
# SENTINEL_DB=data/sentinel.db             # SQLite store (:memory: for ephemeral)
# SENTINEL_DEMO_DATA=1                     # fill an empty named store with synthetic demo data

# ---- trust -----------------------------------------------------------------------------
# SENTINEL_TRUST_STORE=/etc/sentinel/trust.json          # public keys of the issuers whose fact statements are accepted
# SENTINEL_REQUIRE_SIGNED_FACTS=1                        # records read by id must carry their issuer's statement
# SENTINEL_POLICY_TRUST=/etc/sentinel/policy-trust.json  # policy-release root (default: the shipped root)
# SENTINEL_POLICY_DIR=/etc/sentinel/policies             # your copy of the policies, released under that root
# SENTINEL_REQUIRE_SIGNED_POLICY=1                       # 0 runs unsigned policies (decisions record UNSIGNED)
# SENTINEL_REVIEWERS=/etc/sentinel/reviewers.json        # reviewer registry (who may act on cases)
# SENTINEL_REVIEWER_TOKEN=...                            # the CLI's reviewer credential for case commands

# ---- audit -----------------------------------------------------------------------------
# SENTINEL_AUDIT_ANCHOR=/var/lib/sentinel/anchor         # append-only anchor for signed checkpoints
# SENTINEL_AUDIT_KEY=...                                 # legacy HMAC checkpoint key (a shared secret)
